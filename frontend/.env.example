# true  -> deterministic in-browser mock data (default; no backend required)
# false -> call the FastAPI backend at VITE_API_URL (contracts/api.yaml, mapped by src/api/adapters)
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000
# Only with VITE_USE_MOCK=false: endpoints that answer 501 (backend not built yet) or are unreachable are
# served from the mock instead of showing "Not yet available — pipeline pending".
#   false (default) | true (all endpoints) | comma list of Api methods, e.g. screener,companyOverview,modelLab
VITE_MOCK_FALLBACK=false
